# hadolint ignore=DL3006
FROM base-image AS base

FROM python:3.13-slim

COPY --from=base --chown=root:root --chmod=0755 /gosu /usr/bin/gosu
COPY --from=base --chown=root:root --chmod=0755 /tini /usr/bin/tini
COPY --from=base --chown=root:root --chmod=0755 /semaphore /usr/bin/semaphore

RUN set -ex \
 && apt-get update -q \
 && apt-get install -q -y --no-install-recommends \
        ca-certificates \
        curl \
        git \
        net-tools \
        openssh-client \
        sshpass \
        tzdata \
 && rm -rf /var/lib/apt/lists/*

ARG sops_version=3.13.3

RUN set -ex \
 && DL_ARCH="amd64" \
 && if [ "$( arch )" = "aarch64" ] ; then DL_ARCH="arm64" ; fi \
 && URL="https://github.com/getsops/sops/releases/download/v${sops_version}" \
 && curl -fsSLo /usr/bin/sops "${URL}/sops-v${sops_version}.linux.${DL_ARCH}" \
 && chmod +x /usr/bin/sops \
 && sops --version

ARG ansible_version

COPY requirements.txt /tmp/requirements.txt

RUN set -ex \
 && pip install --no-cache-dir \
        ansible-core=="${ansible_version}.*" \
        -r /tmp/requirements.txt \
 && find /usr/local -depth -type d -name '__pycache__' -exec rm -rf '{}' \; \
 && rm -rf ~/.cache

RUN set -ex \
 && addgroup --gid 786 semaphore \
 && adduser --disabled-password --gecos '' --uid 786 --ingroup semaphore semaphore

COPY entrypoint.sh /usr/bin/entrypoint.sh

ENTRYPOINT ["tini", "--", "/usr/bin/entrypoint.sh"]

CMD ["semaphore", "runner", "start", "--no-config"]
