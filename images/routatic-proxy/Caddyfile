{
  log {
    output stderr
    level  {$CADDY_LOG_LEVEL}
    format {$CADDY_LOG_FORMAT} {
      level_format {$CADDY_LOG_FORMAT_LEVEL_FORMAT:upper}
    }
  }
}

:{$CADDY_PORT} {
  @has_proxy_token {
    header {$CADDY_PROXY_HEADER} "{$CADDY_PROXY_TOKEN}"
  }

  handle /health {
    respond "OK"
  }

  handle @has_proxy_token {
    reverse_proxy localhost:{$ROUTATIC_PROXY_PORT}
  }

  handle {
    respond "Unauthorized" 401
  }
}
